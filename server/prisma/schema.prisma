generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  password         String
  name             String?
  surname          String?
  role             String         @default("student")
  avatar           String?
  createdAt        DateTime       @default(now())
  resetToken       String?
  resetTokenExpiry DateTime?
  isActive         Boolean        @default(true)
  bio              String?
  github           String?
  vk               String?
  telegram         String?
  coverColor       String?        @default("#0056D2")
  enrollments      Enrollment[]
  notifications    Notification[]
  comments         Comment[]
  activities       UserActivity[]
}

model UserActivity {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model Course {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  skills      String[]
  category    String?
  image       String?
  rating      Float        @default(0)
  students    Int          @default(0)
  createdAt   DateTime     @default(now())
  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id                Int                @id @default(autoincrement())
  courseId          Int
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  order             Int
  lectureText       String?
  practiceTask      String?
  mediaUrl          String?
  practiceMediaUrl  String?
  documents         Document[]
  practiceDocuments PracticeDocument[]
  questions         Question[]
  comments          Comment[]
}

model Document {
  id       Int    @id @default(autoincrement())
  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name     String
  url      String
  size     String?
}

model PracticeDocument {
  id       Int    @id @default(autoincrement())
  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name     String
  url      String
  size     String?
}

model Question {
  id             Int     @id @default(autoincrement())
  lessonId       Int
  lesson         Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text           String
  isSingleChoice Boolean @default(true)
  options        Json
  correctAnswers Json    @default("[]")
  explanation    String?
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  progress  Int      @default(0)
  status    String   @default("in_progress")
  rating    Int?
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  courseId  Int?
  createdAt DateTime @default(now())
}

model Comment {
  id        Int       @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  text      String
  edited    Boolean   @default(false)
  parentId  Int?
  parent    Comment?  @relation("replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("replies")
  createdAt DateTime  @default(now())
}
